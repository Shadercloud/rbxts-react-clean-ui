    "download-icons": "node --env-file-if-exists=.env.local scripts/download-icons.js"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@rbxts/ui-labs": "^2.4.2",
    "cnfast": "^0.0.8",
    "fumadocs-core": "16.11.5",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.11.5",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-medium-image-zoom": "^5.4.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@loom-dev/renderer": "npm:@shadercloud/loom-runtime@0.11.0-shadercloud.2",
    "@types/react-dom": "^19.2.3",
    "loom-dev": "^0.11.0",
